# Database (Neon — auto-injected by Vercel-Neon integration in Production/Preview)
DATABASE_URL=

# Clerk authentication
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# HighLevel marketplace app
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=
# HighLevel webhooks are verified with public-key crypto (Ed25519 + RSA legacy)
# — see src/lib/ghl/webhook-keys.ts. This env var is retained for completeness
# but not read by any code path.
GHL_WEBHOOK_SECRET=
OAUTH_STATE_SECRET=

# Crypto — 32-byte hex (openssl rand -hex 32)
ENCRYPTION_KEY=

# Pusher Channels
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Vercel cron auth
CRON_SECRET=
